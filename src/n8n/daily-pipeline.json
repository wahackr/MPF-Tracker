      "id": "d04256f5-8329-55d6-a04d-2a485217b429",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        0
      ],
      "notes": "Keep the asOfDate expression for today in Hong Kong, or use a fixed YYYY-MM-DD for recovery. Empty accountId selects all accounts. Set apiKey once here; every HTTP Request node reuses it as the X-API-Key header. Keep real keys out of source exports."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration').first().json.downloadUrl }}",
        "authentication": "none",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { provider: $('Configuration').first().json.provider, rolling_days: $('Configuration').first().json.rollingDays } }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Configuration').first().json.idempotencyKey }}"
            },
            {
              "name": "X-API-Key",
              "value": "={{ $('Configuration').first().json.apiKey }}"
            }
          ]
        }
      },
      "id": "7206a3ef-9fd8-50b0-b569-1ef8add5ea4c",
