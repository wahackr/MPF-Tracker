      "id": "d515c558-99d2-5102-80c9-85b78a0b103b",
      "name": "Process purchases",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nif (!Number.isInteger(result.failed_events) || result.failed_events < 0 || !Number.isInteger(result.waiting_events) || result.waiting_events < 0) {\n  throw new Error('Unexpected purchase response');\n}\nif (result.failed_events > 0) throw new Error(`Purchase processing reported ${result.failed_events} failed events; inspect Process purchases output`);\n// Waiting events are retried on the next daily run. Keep the details in execution output.\nreturn [{ json: { ...result, needsReview: result.waiting_events > 0 } }];"
      },
      "id": "65d31bf3-8393-52d2-8e6e-2455f28b142b",
      "name": "Check purchases",
