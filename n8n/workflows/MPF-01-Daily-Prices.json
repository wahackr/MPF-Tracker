{
  "name": "MPF-01 Daily Prices",
  "nodes": [
    {
      "parameters": {
        "timezone": "Asia/Hong_Kong",
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 7 * * *"
            }
          ]
        }
      },
      "id": "cron-daily-prices",
      "name": "Daily 07:00 HKT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://mpf-crawler-api:8000/v1/crawl/jobs/sync",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.API_KEY}}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{'daily-sync-' + $now.setZone('Asia/Hong_Kong').toFormat('yyyy-MM-dd')}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"provider\":\"all\",\"rolling_days\":7}"
      },
      "id": "http-sync-prices",
      "name": "Trigger crawler sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "wait-sync",
      "name": "Wait 30 seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{\"http://mpf-crawler-api:8000/v1/crawl/jobs/\" + $node[\"Trigger crawler sync\"].json.job_id}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.API_KEY}}"
            }
          ]
        }
      },
      "id": "get-sync-status",
      "name": "Get crawler status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "poll-sync-condition",
              "leftValue": "={{(['queued','running'].includes($json.status) && $runIndex < 40) ? 'continue' : 'stop'}}",
              "rightValue": "continue",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "poll-sync",
      "name": "Poll again?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "success-sync-condition",
              "leftValue": "={{$json.status}}",
              "rightValue": "succeeded",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "success-sync",
      "name": "Crawler succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1600,
        400
      ]
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "={{'Crawler job ' + $json.job_id + ' ended with ' + $json.status + ': ' + JSON.stringify($json.result?.funds_failed ?? $json.error_message ?? '')}}"
      },
      "id": "error-sync",
      "name": "Report crawler failure",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1860,
        520
      ]
    }
  ],
  "connections": {
    "Daily 07:00 HKT": {
      "main": [
        [
          {
            "node": "Trigger crawler sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger crawler sync": {
      "main": [
        [
          {
            "node": "Wait 30 seconds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 30 seconds": {
      "main": [
        [
          {
            "node": "Get crawler status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get crawler status": {
      "main": [
        [
          {
            "node": "Poll again?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll again?": {
      "main": [
        [
          {
            "node": "Wait 30 seconds",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Crawler succeeded?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Crawler succeeded?": {
      "main": [
        [],
        [
          {
            "node": "Report crawler failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "pinData": {}
}
