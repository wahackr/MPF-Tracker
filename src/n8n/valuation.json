{
  "name": "MPF - Rebuild and snapshot valuations",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "cbea6326-67fd-5095-96e6-88ff89577b79",
      "name": "Manual run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 6 * * *"
            }
          ]
        }
      },
      "id": "b8685ad6-ad89-509d-abcf-5a1e0d297a71",
      "name": "Daily 06:00 Hong Kong",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "ac55e965-b3b7-5075-9395-7b4c631c79ec",
              "name": "rebuildUrl",
              "value": "http://mpf-valuation:8000/v1/valuation/rebuild",
              "type": "string"
            },
            {
              "id": "a5412a98-ebda-5183-bf6a-e9c738ee0eb0",
              "name": "snapshotUrl",
              "value": "http://mpf-valuation:8000/v1/valuation/snapshot",
              "type": "string"
            },
            {
              "id": "c6a9999e-c428-5131-9a43-1021f714dbe2",
              "name": "provider",
              "value": "all",
              "type": "string"
            },
            {
              "id": "aa9426d1-d282-58a4-a3b8-c61ca79ed481",
              "name": "rollingDays",
              "value": 7,
              "type": "number"
            },
            {
              "id": "3594b0d6-360d-5ec4-a86d-06d786d33d17",
              "name": "maxPolls",
              "value": 60,
              "type": "number"
            },
            {
              "id": "eb5dbcb5-33f4-5eef-a477-2e3ffbca4f44",
              "name": "asOfDate",
              "value": "={{ $now.setZone('Asia/Hong_Kong').toISODate() }}",
              "type": "string"
            },
            {
              "id": "449c438a-9426-5222-861a-042c6ab21866",
              "name": "accountId",
              "value": "",
              "type": "string"
            },
            {
              "id": "e189ae5b-eb35-574c-9625-14f030c89ba3",
              "name": "idempotencyKey",
              "value": "={{ `mpf-n8n-${$workflow.id}-${$execution.id}` }}",
              "type": "string"
            },
            {
              "id": "f31e4a0f-1336-5a06-b38e-5f1382dbe0bd",
              "name": "apiKey",
              "value": "CHANGE_ME",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "4ae3277d-4381-5332-aa74-c22fbf831ca3",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        0
      ],
      "notes": "Keep the asOfDate expression for today in Hong Kong, or use a fixed YYYY-MM-DD for recovery. Empty accountId selects all accounts. Set apiKey once here; every HTTP Request node reuses it as the X-API-Key header. Keep real keys out of source exports."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration').first().json.rebuildUrl }}",
        "authentication": "none",
        "options": {
          "timeout": 300000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $('Configuration').first().json.accountId ? { account_id: $('Configuration').first().json.accountId } : {} }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Configuration').first().json.apiKey }}"
            }
          ]
        }
      },
      "id": "64cc0f0b-9fa3-5711-9ca1-6e1ddb06ae7f",
      "name": "Rebuild stale valuations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration').first().json.snapshotUrl }}",
        "authentication": "none",
        "options": {
          "timeout": 300000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { as_of_date: $('Configuration').first().json.asOfDate, ...($('Configuration').first().json.accountId ? { account_id: $('Configuration').first().json.accountId } : {}) } }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Configuration').first().json.apiKey }}"
            }
          ]
        }
      },
      "id": "b202ebd3-8881-557b-80b8-caf134e079f7",
      "name": "Save valuation snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nif (result.calculation_status !== 'COMPLETE' || result.unpriced_fund_count !== 0) {\n  throw new Error(`Snapshot saved but needs review: ${result.calculation_status}, unpriced funds: ${result.unpriced_fund_count}`);\n}\nreturn [{ json: result }];"
      },
      "id": "3f0b1635-73f8-54f2-b15f-5ab818ab0a3c",
      "name": "Check valuation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "content": "## Inactive draft \u2014 issue #26\nSet apiKey in Configuration once; HTTP nodes reuse it as X-API-Key.\nReview Configuration and README.md before manual execution.\nFor daily automation publish ONLY daily-pipeline.json.\nStandalone drafts have no cross-workflow dependency checks.\nWaiting purchases remain visible in Check purchases output.",
        "height": 240,
        "width": 520
      },
      "id": "45511554-5b1a-502e-bd43-e50c9130ac59",
      "name": "Setup and activation",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -340
      ]
    }
  ],
