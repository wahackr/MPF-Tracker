{
  "name": "MPF - Daily download, purchases and valuation",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "76e501aa-690a-5e05-bd62-2013380d3ede",
      "name": "Manual run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
