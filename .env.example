# Shared runtime settings
API_KEY=REPLACE_ME
TZ=Asia/Hong_Kong
HEALTH_DB_REQUIRED=true
ENABLE_JOB_WORKER=true
CRAWLER_USE_FIXTURES=true

# Postgres bootstrap/migration credentials
POSTGRES_DB=mpf
POSTGRES_USER=mpf_migrator
POSTGRES_PASSWORD=REPLACE_ME_MIGRATOR_PASSWORD
POSTGRES_HOST=mpf-db
POSTGRES_PORT=5432

# Service DB users and passwords (least privilege)
CRAWLER_DB_PASSWORD=REPLACE_ME_CRAWLER_PASSWORD
PORTFOLIO_DB_PASSWORD=REPLACE_ME_PORTFOLIO_PASSWORD
PURCHASE_DB_PASSWORD=REPLACE_ME_PURCHASE_PASSWORD
VALUATION_DB_PASSWORD=REPLACE_ME_VALUATION_PASSWORD

# External private network shared with existing n8n deployment
N8N_NETWORK=automation
