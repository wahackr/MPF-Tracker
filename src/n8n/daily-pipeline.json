      },
      "id": "c82c9b6c-6aec-51e4-a1d0-97ace47d5b7b",
      "name": "Daily 06:00 Hong Kong",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Public settings only. Select the API key credential on each HTTP Request node.\nconst settings = {\n  crawlerUrl: 'http://mpf-crawler-api:8000',\n  purchaseUrl: 'http://mpf-purchase:8000',\n  valuationUrl: 'http://mpf-valuation:8000',\n  provider: 'all',\n  rollingDays: 7,\n  maxPolls: 60,\n  // Empty means today's Hong Kong date; use YYYY-MM-DD for manual recovery.\n  asOfDate: '',\n  // Empty means all accounts. Crawler always refreshes the chosen provider(s).\n  accountId: '',\n};\nreturn [{ json: {\n  ...settings,\n  asOfDate: settings.asOfDate || $now.setZone('Asia/Hong_Kong').toISODate(),\n  idempotencyKey: `mpf-n8n-${$workflow.id}-${$execution.id}`,\n} }];"
      },
      "id": "d04256f5-8329-55d6-a04d-2a485217b429",
      "name": "Configuration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration').first().json.crawlerUrl + '/v1/crawl/jobs/sync' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { provider: $('Configuration').first().json.provider, rolling_days: $('Configuration').first().json.rollingDays } }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Configuration').first().json.idempotencyKey }}"
            }
          ]
        }
      },
      "id": "7206a3ef-9fd8-50b0-b569-1ef8add5ea4c",
      "name": "Queue download",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configuration').first().json.crawlerUrl + '/v1/crawl/jobs/' + $('Queue download').first().json.job_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "17803ae7-faa0-58d9-be8a-2cc070b7e6d5",
      "name": "Read crawl job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const job = $input.first().json;\nconst expectedId = $('Queue download').first().json.job_id;\nif (!expectedId || job.job_id !== expectedId) throw new Error('Crawler job ID missing or mismatched');\nif (job.status === 'succeeded') return [{ json: { ...job, crawlComplete: true } }];\nif (!['queued', 'running'].includes(job.status)) {\n  throw new Error(`Crawler ${job.job_id}: ${job.status}; ${job.error_message || JSON.stringify(job.result)}`);\n}\nif ($runIndex + 1 >= $('Configuration').first().json.maxPolls) {\n  throw new Error(`Crawler ${job.job_id}: polling limit reached; inspect the existing job before restarting`);\n}\nreturn [{ json: { ...job, crawlComplete: false } }];"
      },
      "id": "7cee3287-4634-5a60-a0ff-7c82733e8f15",
      "name": "Check crawl result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c8e888e4-4ceb-5e52-b261-7f7ac6c1ae9c",
              "leftValue": "={{ $json.crawlComplete }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5f4e7d97-0447-5678-8d04-4cc58fae02e6",
      "name": "Crawl succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1440,
        0
      ]
    },
    {
      "parameters": {
