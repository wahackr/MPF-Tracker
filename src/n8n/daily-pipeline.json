        "amount": 30,
        "unit": "seconds"
      },
      "id": "ec9ef784-5724-5d89-838d-486e9cbbaab0",
      "name": "Wait 30 seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
