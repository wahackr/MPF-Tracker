      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configuration').first().json.crawlJobUrl + $('Queue download').first().json.job_id }}",
        "authentication": "none",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Configuration').first().json.apiKey }}"
            }
          ]
        }
      },
      "id": "17803ae7-faa0-58d9-be8a-2cc070b7e6d5",
      "name": "Read crawl job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const job = $input.first().json;\nconst expectedId = $('Queue download').first().json.job_id;\nif (!expectedId || job.job_id !== expectedId) throw new Error('Crawler job ID missing or mismatched');\nif (job.status === 'succeeded') return [{ json: { ...job, crawlComplete: true } }];\nif (!['queued', 'running'].includes(job.status)) {\n  throw new Error(`Crawler ${job.job_id}: ${job.status}; ${job.error_message || JSON.stringify(job.result)}`);\n}\nif ($runIndex + 1 >= $('Configuration').first().json.maxPolls) {\n  throw new Error(`Crawler ${job.job_id}: polling limit reached; inspect the existing job before restarting`);\n}\nreturn [{ json: { ...job, crawlComplete: false } }];"
      },
      "id": "7cee3287-4634-5a60-a0ff-7c82733e8f15",
      "name": "Check crawl result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c8e888e4-4ceb-5e52-b261-7f7ac6c1ae9c",
              "leftValue": "={{ $json.crawlComplete }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5f4e7d97-0447-5678-8d04-4cc58fae02e6",
      "name": "Crawl succeeded?",
