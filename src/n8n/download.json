      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 6 * * *"
            }
          ]
        }
      },
      "id": "ab41d847-17da-502c-87da-dc9fc66c6af8",
      "name": "Daily 06:00 Hong Kong",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "cd922177-fa3a-54b8-8887-9d681abbe77a",
              "name": "downloadUrl",
              "value": "http://mpf-crawler-api:8000/v1/crawl/jobs/sync",
              "type": "string"
            },
            {
              "id": "cd68d0a5-c7dc-5c4d-b5fe-c8a9a9f5961f",
              "name": "crawlJobUrl",
              "value": "http://mpf-crawler-api:8000/v1/crawl/jobs/",
              "type": "string"
            },
            {
              "id": "21bdad5c-63d9-5f00-8790-37d6f46fad6a",
              "name": "provider",
              "value": "all",
              "type": "string"
            },
            {
              "id": "07393b1c-44db-562d-9702-08ee6d233f2c",
              "name": "rollingDays",
              "value": 7,
              "type": "number"
            },
            {
              "id": "048f7876-56e6-5d97-a6f5-f9bedd6999d7",
              "name": "maxPolls",
              "value": 60,
              "type": "number"
            },
            {
              "id": "1f8610ea-7930-5777-af30-1d084f8fef7a",
              "name": "asOfDate",
              "value": "={{ $now.setZone('Asia/Hong_Kong').toISODate() }}",
              "type": "string"
            },
            {
              "id": "f0d06fd1-1198-51a8-b4ea-fb026e4d6ec0",
              "name": "accountId",
              "value": "",
              "type": "string"
            },
            {
              "id": "77fe51c4-a816-5c63-a86e-1d65c4b5023f",
              "name": "idempotencyKey",
              "value": "={{ `mpf-n8n-${$workflow.id}-${$execution.id}` }}",
              "type": "string"
            },
            {
              "id": "44e6e592-800f-5c50-a728-6904b8568916",
              "name": "apiKey",
              "value": "CHANGE_ME",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "9ba40715-51a5-56ce-aba2-bb08084250be",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        0
      ],
      "notes": "Keep the asOfDate expression for today in Hong Kong, or use a fixed YYYY-MM-DD for recovery. Empty accountId selects all accounts. Set apiKey once here; every HTTP Request node reuses it as the X-API-Key header. Keep real keys out of source exports."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration').first().json.downloadUrl }}",
        "authentication": "none",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { provider: $('Configuration').first().json.provider, rolling_days: $('Configuration').first().json.rollingDays } }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Configuration').first().json.idempotencyKey }}"
            },
            {
              "name": "X-API-Key",
              "value": "={{ $('Configuration').first().json.apiKey }}"
            }
          ]
        }
      },
      "id": "9467ba95-5c12-5121-8bae-42efb6124c54",
      "name": "Queue download",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configuration').first().json.crawlJobUrl + $('Queue download').first().json.job_id }}",
        "authentication": "none",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Configuration').first().json.apiKey }}"
            }
          ]
        }
      },
      "id": "fe893bca-8c9c-5fb6-813b-9a478b8ab048",
      "name": "Read crawl job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const job = $input.first().json;\nconst expectedId = $('Queue download').first().json.job_id;\nif (!expectedId || job.job_id !== expectedId) throw new Error('Crawler job ID missing or mismatched');\nif (job.status === 'succeeded') return [{ json: { ...job, crawlComplete: true } }];\nif (!['queued', 'running'].includes(job.status)) {\n  throw new Error(`Crawler ${job.job_id}: ${job.status}; ${job.error_message || JSON.stringify(job.result)}`);\n}\nif ($runIndex + 1 >= $('Configuration').first().json.maxPolls) {\n  throw new Error(`Crawler ${job.job_id}: polling limit reached; inspect the existing job before restarting`);\n}\nreturn [{ json: { ...job, crawlComplete: false } }];"
      },
      "id": "bc96076b-7332-57c8-a214-1e80ba10bc94",
      "name": "Check crawl result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "3d918bbc-ec5b-57e6-b61d-163cfab1fd2c",
              "leftValue": "={{ $json.crawlComplete }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3aafc1a1-cdde-5d03-839c-abb469d85e77",
      "name": "Crawl succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1440,
        0
      ]
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 30,
        "unit": "seconds"
      },
      "id": "913dc123-bbc5-53e8-9024-6321cc03810f",
      "name": "Wait 30 seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1440,
        260
      ],
      "webhookId": "ed0bd057-ac7b-5d93-9e30-497f9bb20be8"
