{
  "name": "MPF-03 Expected Purchases",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 8 * * *"
            }
          ]
        }
      },
      "id": "cron-daily-purchases",
      "name": "Daily 08:00 HKT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://mpf-purchase:8000/v1/purchase/jobs/process-due",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"as_of_date\":\"={{$now.toFormat('yyyy-MM-dd')}}\"}"
      },
      "id": "http-process-due",
      "name": "Trigger purchase process-due",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ]
    }
  ],
  "connections": {
    "Daily 08:00 HKT": {
      "main": [
        [
          {
            "node": "Trigger purchase process-due",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "pinData": {}
}

