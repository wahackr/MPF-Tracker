{
  "name": "MPF-02 Manual Backfill",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-backfill",
      "name": "Manual backfill",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://mpf-crawler-api:8000/v1/crawl/jobs/backfill",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({provider:'hsbc',from_date:$now.minus({days:13}).toFormat('yyyy-MM-dd'),to_date:$now.toFormat('yyyy-MM-dd')})}}"
      },
      "id": "http-weekly-backfill",
      "name": "Trigger crawler backfill",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "wait-backfill",
      "name": "Wait 30 seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{\"http://mpf-crawler-api:8000/v1/crawl/jobs/\" + $node[\"Trigger crawler backfill\"].json.job_id}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.API_KEY}}"
            }
          ]
        }
      },
      "id": "get-backfill-status",
      "name": "Get crawler status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "poll-backfill-condition",
              "leftValue": "={{(['queued','running'].includes($json.status) && $runIndex < 40) ? 'continue' : 'stop'}}",
              "rightValue": "continue",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "poll-backfill",
      "name": "Poll again?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "success-backfill-condition",
              "leftValue": "={{$json.status}}",
              "rightValue": "succeeded",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "success-backfill",
      "name": "Crawler succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1600,
        400
      ]
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "={{'Crawler job ' + $json.job_id + ' ended with ' + $json.status + ': ' + JSON.stringify($json.result?.funds_failed ?? $json.error_message ?? '')}}"
      },
      "id": "error-backfill",
      "name": "Report crawler failure",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1860,
        520
      ]
    }
  ],
  "connections": {
    "Manual backfill": {
      "main": [
        [
          {
            "node": "Trigger crawler backfill",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger crawler backfill": {
      "main": [
        [
          {
            "node": "Wait 30 seconds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 30 seconds": {
      "main": [
        [
          {
            "node": "Get crawler status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get crawler status": {
      "main": [
        [
          {
            "node": "Poll again?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll again?": {
      "main": [
        [
          {
            "node": "Wait 30 seconds",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Crawler succeeded?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Crawler succeeded?": {
      "main": [
        [],
        [
          {
            "node": "Report crawler failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "pinData": {}
}
