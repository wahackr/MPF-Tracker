{
  "name": "MPF - Process purchase estimates",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "09fec3a0-061e-5b0c-9d71-9ab3889a5320",
      "name": "Manual run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 6 * * *"
            }
          ]
        }
      },
      "id": "2f1ccff7-0e33-5fe2-ae13-3d4738f8123a",
      "name": "Daily 06:00 Hong Kong",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "f172877b-c342-56aa-a067-9462fca7ce9f",
              "name": "purchaseUrl",
              "value": "http://mpf-purchase:8000/v1/purchases/process",
              "type": "string"
            },
            {
              "id": "c8571cd3-207f-5121-af9e-5abcdfbe8109",
              "name": "provider",
              "value": "all",
              "type": "string"
            },
            {
              "id": "372548aa-66b4-5508-8a3f-358baa96a9a7",
              "name": "rollingDays",
              "value": 7,
              "type": "number"
            },
            {
              "id": "ab6b98b4-8063-57de-a9ec-104f186e14b0",
              "name": "maxPolls",
              "value": 60,
              "type": "number"
            },
            {
              "id": "cfae385c-eff3-5215-9c7d-c3c6c09e794f",
              "name": "asOfDate",
              "value": "={{ $now.setZone('Asia/Hong_Kong').toISODate() }}",
              "type": "string"
            },
            {
              "id": "daa4e0f3-fe05-5a20-b098-f1d266e0b031",
              "name": "accountId",
              "value": "",
              "type": "string"
            },
            {
              "id": "69c98886-e5d4-5d54-bc27-13ac220d76bd",
              "name": "idempotencyKey",
              "value": "={{ `mpf-n8n-${$workflow.id}-${$execution.id}` }}",
              "type": "string"
            },
            {
              "id": "fcd7d3ed-b98e-598e-b5f3-62090017629a",
              "name": "apiKey",
              "value": "CHANGE_ME",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "7eb3a178-bc43-5f44-9098-30afd7feef78",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        0
      ],
      "notes": "Keep the asOfDate expression for today in Hong Kong, or use a fixed YYYY-MM-DD for recovery. Empty accountId selects all accounts. Set apiKey once here; every HTTP Request node reuses it as the X-API-Key header. Keep real keys out of source exports."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration').first().json.purchaseUrl }}",
        "authentication": "none",
        "options": {
          "timeout": 300000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { as_of_date: $('Configuration').first().json.asOfDate, ...($('Configuration').first().json.accountId ? { account_id: $('Configuration').first().json.accountId } : {}) } }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Configuration').first().json.apiKey }}"
            }
          ]
        }
      },
      "id": "53fd80d6-9d3b-5557-8ea9-4536b0b0a8c9",
      "name": "Process purchases",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nif (!Number.isInteger(result.failed_events) || result.failed_events < 0 || !Number.isInteger(result.waiting_events) || result.waiting_events < 0) {\n  throw new Error('Unexpected purchase response');\n}\nif (result.failed_events > 0) throw new Error(`Purchase processing reported ${result.failed_events} failed events; inspect Process purchases output`);\n// Waiting events are retried on the next daily run. Keep the details in execution output.\nreturn [{ json: { ...result, needsReview: result.waiting_events > 0 } }];"
      },
      "id": "8fea0ac8-7c9a-55ab-8646-839000a9caa0",
      "name": "Check purchases",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "content": "## Inactive draft \u2014 issue #26\nSet apiKey in Configuration once; HTTP nodes reuse it as X-API-Key.\nReview Configuration and README.md before manual execution.\nFor daily automation publish ONLY daily-pipeline.json.\nStandalone drafts have no cross-workflow dependency checks.\nWaiting purchases remain visible in Check purchases output.",
        "height": 240,
        "width": 520
      },
      "id": "841fe68b-7052-521f-b4e9-8b4268f6892b",
      "name": "Setup and activation",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -340
      ]
    }
  ],
  "connections": {
    "Manual run": {
      "main": [
        [
          {
            "node": "Configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily 06:00 Hong Kong": {
      "main": [
        [
          {
            "node": "Configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configuration": {
      "main": [
        [
          {
            "node": "Process purchases",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process purchases": {
      "main": [
        [
          {
            "node": "Check purchases",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Hong_Kong",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "pinData": {},
  "tags": []
}
